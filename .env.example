# Production settings for docker-compose.prod.yml. Copy to .env on the server (gitignored) and fill in.
# One KEY=value per line, no quotes needed. Generate secrets with: openssl rand -hex 24
# Database passwords must not contain ';' (they go inside a connection string), so use hex.
# Use a different secret for each value; the MariaDB ones are only read when the database is first created.

# --- Database ---
MARIADB_ROOT_PASSWORD=
BLOOM_DB_PASSWORD=
ARSR_DB_PASSWORD=

# --- Backend secrets ---
# Signs robot tokens. At least 32 bytes: openssl rand -base64 48
JWT_KEY=
# Password of the seeded admin@example.com account (used only when that account doesn't exist yet).
SEED_ADMIN_PASSWORD=
# Password of the PKCS#12 file that encrypts the ASP.NET data-protection keys (see docs/deploy-docker.md).
DP_CERT_PASSWORD=

# --- Email (account confirmation) ---
# Sign-in requires a confirmed email address, so the server must be able to send mail (STARTTLS on SMTP_PORT).
# Leave SMTP_USER/SMTP_PASSWORD empty for a relay that does not require authentication.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Public https address users reach Bloom at; confirmation links are built from it, e.g. https://bloom.example.edu
PUBLIC_BASE_URL=

# --- Optional ---
# AI lesson generation (Azure OpenAI). Leave empty to leave it unconfigured.
#AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
#AZURE_OPENAI_KEY=
#AZURE_OPENAI_DEPLOYMENT=
#AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Where the certificate file is on the host (default ./certs/bloomserver.pfx next to this file).
#DP_CERT_FILE=./certs/bloomserver.pfx
# Host port the server is published on (the container itself listens on 8080), loopback only by default.
# A TLS proxy on the host forwards here; a proxy in a container should share a network with bloom-server instead.
#BLOOM_HTTP_PORT=8080
#BLOOM_BIND=127.0.0.1
# The fleet remote shell (admin terminal into robots). Requires https in front.
#REMOTE_SHELL_ENABLED=true
# Token for reading GitHub Releases of a private repo (the fleet version picker); public repos need none.
#GITHUB_RELEASES_TOKEN=
# Name of the network of a reverse proxy that runs in a container (`podman network ls`). When set, bloom-server
# joins it so the proxy can use `proxy_pass http://bloom-server:8080;` (docker-compose.proxy.yml).
#PROXY_NETWORK=web_webnet
