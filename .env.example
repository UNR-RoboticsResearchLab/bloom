# Production settings for docker-compose.prod.yml. Copy to .env on the server (gitignored) and fill in.
# One KEY=value per line, no quotes needed. Generate secrets with: openssl rand -hex 24
# Database passwords must not contain ';' (they go inside a connection string), so use hex.

# --- Database ---
MARIADB_ROOT_PASSWORD=
BLOOM_DB_PASSWORD=
ARSR_DB_PASSWORD=

# --- Backend secrets ---
# Signs robot tokens. At least 32 bytes: openssl rand -base64 48
JWT_KEY=
# Password of the seeded admin@example.com account (used only when that account doesn't exist yet).
SEED_ADMIN_PASSWORD=
# Password of the PKCS#12 file that encrypts the ASP.NET data-protection keys (see docs/deploy-docker.md).
DP_CERT_PASSWORD=

# --- Optional ---
# AI lesson generation (Azure OpenAI). Leave empty to leave it unconfigured.
#AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
#AZURE_OPENAI_KEY=
#AZURE_OPENAI_DEPLOYMENT=
#AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Where the certificate file is on the host (default ./certs/bloomserver.pfx next to this file).
#DP_CERT_FILE=./certs/bloomserver.pfx
# Host port the server is published on, loopback only by default. Your TLS proxy forwards here.
#BLOOM_HTTP_PORT=5000
#BLOOM_BIND=127.0.0.1
# The fleet remote shell (admin terminal into robots). Requires https in front.
#REMOTE_SHELL_ENABLED=true
# --- Development stack on the server (docker-compose.yml; see docs/deploy-docker.md) ---
# DEV_BIND is required by deploy-dev-stack.sh: the address its ports are published on (the server's Tailscale
# address, `tailscale ip -4`, or 127.0.0.1). Never leave the dev stack on every interface.
#DEV_BIND=100.x.y.z
#DEV_DB_BIND=127.0.0.1
# Host ports (defaults shown). Change any that are already taken on the server. DEV_PUBLIC_ORIGINS must use
# the frontend port you pick, and the dev frontend finds the API on the page's own host at DEV_API_PORT.
#DEV_FRONTEND_PORT=3000
#DEV_API_PORT=8080
#DEV_HTTPS_PORT=2443
#DEV_DB_PORT=3306
#DEV_ARSR_DB_PORT=3307
# Origins you open the dev frontend from (CORS allows only localhost and private-LAN addresses otherwise).
#DEV_PUBLIC_ORIGINS=http://<tailnet-name>:3000,http://100.x.y.z:3000
# Password for the seeded admin@example.com of a new dev database (default: the public Admin@123).
#DEV_ADMIN_PASSWORD=
# Token for reading GitHub Releases of a private repo (the fleet version picker); public repos need none.
#GITHUB_RELEASES_TOKEN=
