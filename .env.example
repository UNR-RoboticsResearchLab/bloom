# Production settings for docker-compose.prod.yml. Copy to .env on the server (gitignored) and fill in.
# One KEY=value per line, no quotes needed. Generate secrets with: openssl rand -hex 24
# Database passwords must not contain ';' (they go inside a connection string), so use hex.

# --- Database ---
MARIADB_ROOT_PASSWORD=
BLOOM_DB_PASSWORD=
ARSR_DB_PASSWORD=

# --- Backend secrets ---
# Signs robot tokens. At least 32 bytes: openssl rand -base64 48
JWT_KEY=
# Password of the seeded admin@example.com account (used only when that account doesn't exist yet).
SEED_ADMIN_PASSWORD=
# Password of the PKCS#12 file that encrypts the ASP.NET data-protection keys (see docs/deploy-docker.md).
DP_CERT_PASSWORD=

# --- Optional ---
# Where the certificate file is on the host (default ./certs/bloomserver.pfx next to this file).
#DP_CERT_FILE=./certs/bloomserver.pfx
# Host port the server is published on, loopback only by default. Your TLS proxy forwards here.
#BLOOM_HTTP_PORT=5000
#BLOOM_BIND=127.0.0.1
# The fleet remote shell (admin terminal into robots). Requires https in front.
#REMOTE_SHELL_ENABLED=true
# Token for reading GitHub Releases of a private repo (the fleet version picker); public repos need none.
#GITHUB_RELEASES_TOKEN=
