# Copy to .env.study and replace both passwords before the first deployment.
STUDY_DB_PASSWORD=replace-with-random-study-database-password
STUDY_ARSR_DB_PASSWORD=replace-with-random-analysis-database-password
# Use 8082 on the LX host, where Jenkins already occupies 8081.
STUDY_PORT=8082
# Optional: a compatible AutoRSR service reachable from inside Docker.
STUDY_ANALYSIS_URL=http://host.docker.internal:5050
