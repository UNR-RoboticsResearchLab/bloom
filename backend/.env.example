# Backend environment — LessonAiService (Azure OpenAI lesson/step generation)
# Loaded by Program.cs before CreateBuilder; real environment variables always win.
# Parser notes: one KEY=value per line, surrounding double quotes are stripped,
# no inline comments (anything after '=' is the value).

# Resource endpoint, e.g. https://<resource-name>.openai.azure.com/
# Keep the trailing slash — requests are built relative to this base address.
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/

# Key 1 or Key 2 from the Azure OpenAI resource's "Keys and Endpoint" page (sent as the api-key header)
AZURE_OPENAI_KEY=

# Deployment name (not the model name) of a model that supports json_schema structured outputs, e.g. gpt-4o
AZURE_OPENAI_DEPLOYMENT=

# Optional — defaults to 2024-08-01-preview (the minimum that supports json_schema response_format)
AZURE_OPENAI_API_VERSION=2024-08-01-preview
