    {
      "name": "Interactive Q&A",
      "lesson": {
        "lesson_id": "interactive_001",
        "title": "Interactive Question",
        "learning_objectives": ["Answer questions"],
        "sequence": [
          {
            "id": 1,
            "type": "introduction",
            "script": "Let me ask you a question.",
            "behaviors": { "behavior": "happy" },
            "timing_seconds": 2
          },
          {
            "id": 2,
            "type": "interactive_question",
            "script": "What is two plus two?",
            "behaviors": { "behavior": "invite_response", "gaze": "audience_member" },
            "has_interaction": true,
            "interaction": {
              "wait_for_response": true,
              "max_wait_seconds": 8,
              "correct_answer": "four",
              "correct_response_script": "Correct! Two plus two equals four!",
              "incorrect_response_script": "Not quite. Two plus two equals four.",
              "fallback_script": "Two plus two equals four."
            }
          },
          {
            "id": 3,
            "type": "closing",
            "script": "Great effort!",
            "behaviors": { "behavior": "happy" },
            "timing_seconds": 2
          }
        ]
      }
    },
    {
      "name": "Homophones Lesson",
      "lesson": {
        "lesson_id": "homophones_001",
        "title": "Homophones",
        "learning_objectives": [
          "Identify homophones",
          "Understand differences in meaning",
          "Use context clues"
        ],
        "sequence": [
          {
            "id": 1,
            "type": "introduction",
            "script": "Hello! Today we learn about homophones. Homophones are words that sound the same but have different meanings and spellings.",
            "behaviors": {
              "behavior": "happy",
              "facial_expression": "smile",
              "gaze": "scan_room"
            },
            "timing_seconds": 8
          },
          {
            "id": 2,
            "type": "example",
            "script": "For example: sea and see. They sound the same. Sea is the ocean. See means to look with your eyes.",
            "behaviors": {
              "behavior": "idle",
              "facial_expression": "engaged",
              "gaze": "center"
            },
            "timing_seconds": 10
          },
          {
            "id": 3,
            "type": "example",
            "script": "Another example: their, there, and they're. Their shows ownership. There tells a location. They're means they are.",
            "behaviors": {
              "behavior": "idle",
              "facial_expression": "thoughtful",
              "gaze": "center"
            },
            "timing_seconds": 12
          },
          {
            "id": 4,
            "type": "interactive_question",
            "script": "Can you give me a homophone pair?",
            "behaviors": {
              "behavior": "invite_response",
              "posture": "lean_forward",
              "gaze": "audience_member"
            },
            "has_interaction": true,
            "interaction": {
              "wait_for_response": true,
              "max_wait_seconds": 10,
              "fallback_script": "One example is right and write. Right means correct or a direction. Write means to put words on paper."
            }
          },
          {
            "id": 5,
            "type": "closing",
            "script": "Excellent! You now understand homophones. Remember to use context to figure out which homophone to use.",
            "behaviors": {
              "behavior": "happy",
              "facial_expression": "warm_smile",
              "gaze": "scan_room"
            },
            "timing_seconds": 8
          }
        ]
      }
    },
    {
