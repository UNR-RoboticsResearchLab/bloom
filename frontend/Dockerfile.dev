# ClientApp/Dockerfile.dev
FROM docker.io/library/node:20-alpine

WORKDIR /app

COPY package*.json ./

# From the lockfile, as CI does: `npm install` re-resolves the whole tree from the registry on every build.
RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --no-fund --silent

COPY . .

EXPOSE 3000

CMD ["npm", "start"]