# Bloom Robot - Environment Variables
# Where this file lives:
#   dev machine:  copy to robot/.env (git-ignored); bloom.service loads it via EnvironmentFile=, and
#                 outside systemd run with BLOOM_ENV_FILE=robot/.env
#   a robot:      /etc/bloom/robot.env, root:root 0600, created at provisioning. systemd reads it
#                 (EnvironmentFile=) before the nodes start. No package ships or overwrites it, so
#                 OTA updates and rollbacks never touch these secrets.

# ── Azure OpenAI (LLM) ──────────────────────────────────────────────────────
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ── Azure Text-to-Speech ────────────────────────────────────────────────────
AZURE_TTS_KEY=your_azure_tts_key_here
AZURE_TTS_REGION=westus2
AZURE_TTS_VOICE=en-US-AvaNeural
# ── Backend credentials ─────────────────────────────────────────────────────
# Issued once by an admin: POST /api/robot/register (new robot) or
# POST /api/robot/{id}/credentials (rotate). Robots no longer self-register.
BLOOM_ROBOT_ID=
BLOOM_ROBOT_SECRET=
