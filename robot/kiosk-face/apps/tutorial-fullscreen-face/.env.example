# Base URL of the bloom backend, used to poll for queued RSR sentences and
# fetch the pre-generated audio/viseme assets it serves from wwwroot/rsr-audio.
VITE_BLOOM_API_URL=http://localhost:5000

# Local bloom_face_bridge endpoints (see robot/src/bloom_face_bridge) -- only
# relevant when this app runs on the physical robot alongside its ROS graph.
# Bridges live emotion/viseme/visual-aid/mic/pairing-code state; not needed
# for the cloud-only RSR flow (VITE_BLOOM_API_URL above).
VITE_FACE_BRIDGE_WS_URL=ws://localhost:8765
VITE_FACE_BRIDGE_HTTP_URL=http://localhost:8766
